{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Group Ruby runtime version and image digest updates",
      "extends": ["./ruby-digest-images"],
      "matchPackageNames": [
        "ruby",
        "library/ruby",
        "docker.io/ruby",
        "docker.io/library/ruby",
        "index.docker.io/ruby",
        "index.docker.io/library/ruby",
        "registry-1.docker.io/ruby",
        "registry-1.docker.io/library/ruby"
      ],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Ruby",
      "groupSingleUpdates": true
    },
    {
      "description": "Pin Ruby image digests",
      "extends": ["./ruby-digest-images"],
      "pinDigests": true
    },
    {
      "description": "Automerge Ruby image digest and patch updates after required checks",
      "extends": ["./ruby-digest-images"],
      "matchUpdateTypes": ["digest", "patch"],
      "automerge": true,
      "automergeType": "branch"
    }
  ]
}
