{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Keep PostgreSQL images on major version 18 and preserve the current Docker tag variant.",
      "matchDatasources": ["docker"],
      "extends": ["./postgresql-image-names"],
      "versioning": "docker",
      "allowedVersions": "/^18(?:[.-]|$)/"
    },
    {
      "description": "Group updates for PostgreSQL 18 images",
      "extends": ["./postgresql-image-names"],
      "matchDatasources": ["docker"],
      "matchCurrentValue": "/^18(?:[.-]|$)/",
      "groupName": "PostgreSQL 18",
      "groupSingleUpdates": true
    }
  ]
}
