{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Keep PostgreSQL images on major version 18 and preserve the current Docker tag variant.",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "postgres",
        "library/postgres",
        "docker.io/postgres",
        "docker.io/library/postgres",
        "index.docker.io/postgres",
        "index.docker.io/library/postgres",
        "registry-1.docker.io/postgres",
        "registry-1.docker.io/library/postgres"
      ],
      "groupName": "PostgreSQL 18",
      "groupSingleUpdates": true,
      "versioning": "docker",
      "allowedVersions": "/^18(?:[.-]|$)/"
    }
  ]
}
